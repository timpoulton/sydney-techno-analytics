// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  events        Event[]
  uploads       Upload[]
  customMetrics CustomMetric[]
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  name           String
  organizationId String
  role           Role      @default(MEMBER)
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  uploads      Upload[]
  customMetrics CustomMetric[]
}

enum Role {
  ADMIN
  MEMBER
}

model Event {
  id             String       @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  venue          String
  city           String       @default("Sydney")
  capacity       Int?
  status         EventStatus  @default(UPCOMING)
  platform       Platform
  externalId     String
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  tickets      Ticket[]
  artists      EventArtist[]
  metrics      EventMetrics?

  @@unique([organizationId, platform, externalId])
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum Platform {
  RESIDENT_ADVISOR
  HUMANITIX
  MOSHTIX
}

model Upload {
  id               String       @id @default(uuid())
  organizationId   String
  userId           String
  filename         String
  fileSize         Int
  platform         Platform
  status           UploadStatus @default(PENDING)
  recordsProcessed Int          @default(0)
  recordsFailed    Int          @default(0)
  errorLog         String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  tickets      Ticket[]
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Ticket {
  id            String   @id @default(uuid())
  eventId       String
  uploadId      String
  ticketType    String
  price         Decimal
  quantity      Int
  sold          Int
  revenue       Decimal
  purchaseDate  DateTime
  buyerEmail    String?
  buyerPostcode String?
  metadata      Json?
  createdAt     DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id])
  upload Upload @relation(fields: [uploadId], references: [id])
}

model Artist {
  id          String   @id @default(uuid())
  name        String
  bio         String?
  imageUrl    String?
  socialLinks Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events EventArtist[]
}

model EventArtist {
  eventId          String
  artistId         String
  performanceOrder Int
  performanceTime  String?
  createdAt        DateTime @default(now())

  event  Event  @relation(fields: [eventId], references: [id])
  artist Artist @relation(fields: [artistId], references: [id])

  @@id([eventId, artistId])
}

model Venue {
  id             String   @id @default(uuid())
  name           String
  address        String
  city           String
  postcode       String
  capacity       Int?
  coordinates    Json?
  transportNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EventMetrics {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  totalRevenue        Decimal
  totalTicketsSold    Int
  averageTicketPrice  Decimal
  sellOutPercentage   Float
  earlyBirdConversion Float
  topPostcodes        Json?
  ageDistribution     Json?
  salesVelocity       Json?
  peakSalesHour       Int?
  daysToSellOut       Int?
  customMetrics       Json?
  lastCalculated      DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id])
}

model CustomMetric {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String
  formula        String
  category       MetricCategory
  isActive       Boolean        @default(true)
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  creator      User         @relation(fields: [createdBy], references: [id])
}

enum MetricCategory {
  REVENUE
  ATTENDANCE
  ENGAGEMENT
  CUSTOM
}