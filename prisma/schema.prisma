generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id            String         @id @default(uuid())
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  customMetrics CustomMetric[]
  events        Event[]
  uploads       Upload[]
  users         User[]
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  organizationId String
  role           Role           @default(MEMBER)
  lastLoginAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  customMetrics  CustomMetric[]
  uploads        Upload[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model Event {
  id             String        @id @default(uuid())
  organizationId String
  name           String
  date           DateTime
  venue          String
  city           String        @default("Sydney")
  capacity       Int?
  status         EventStatus   @default(UPCOMING)
  platform       Platform
  externalId     String
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id])
  artists        EventArtist[]
  metrics        EventMetrics?
  tickets        Ticket[]

  @@unique([organizationId, platform, externalId])
}

model Upload {
  id               String       @id @default(uuid())
  organizationId   String
  userId           String
  filename         String
  fileSize         Int
  platform         Platform
  status           UploadStatus @default(PENDING)
  recordsProcessed Int          @default(0)
  recordsFailed    Int          @default(0)
  errorLog         String?
  processedAt      DateTime?
  createdAt        DateTime     @default(now())
  tickets          Ticket[]
  organization     Organization @relation(fields: [organizationId], references: [id])
  user             User         @relation(fields: [userId], references: [id])
}

model Ticket {
  id               String   @id @default(uuid())
  eventId          String
  uploadId         String
  ticketType       String
  price            Decimal
  quantity         Int
  sold             Int
  revenue          Decimal
  purchaseDate     DateTime
  metadata         Json?
  createdAt        DateTime @default(now())
  barcode          String?
  customerEmail    String?
  customerName     String?
  customerPostcode String?
  marketingOptIn   Boolean  @default(false)
  orderNumber      String?
  event            Event    @relation(fields: [eventId], references: [id])
  upload           Upload   @relation(fields: [uploadId], references: [id])

  @@index([customerEmail])
  @@index([customerPostcode])
}

model Artist {
  id          String        @id @default(uuid())
  name        String
  bio         String?
  imageUrl    String?
  socialLinks Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  events      EventArtist[]
}

model EventArtist {
  eventId          String
  artistId         String
  performanceOrder Int
  performanceTime  String?
  createdAt        DateTime @default(now())
  artist           Artist   @relation(fields: [artistId], references: [id])
  event            Event    @relation(fields: [eventId], references: [id])

  @@id([eventId, artistId])
}

model Venue {
  id             String   @id @default(uuid())
  name           String
  address        String
  city           String
  postcode       String
  capacity       Int?
  coordinates    Json?
  transportNotes String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EventMetrics {
  id                  String   @id @default(uuid())
  eventId             String   @unique
  totalRevenue        Decimal
  totalTicketsSold    Int
  averageTicketPrice  Decimal
  sellOutPercentage   Float
  earlyBirdConversion Float
  topPostcodes        Json?
  ageDistribution     Json?
  salesVelocity       Json?
  peakSalesHour       Int?
  daysToSellOut       Int?
  customMetrics       Json?
  lastCalculated      DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  event               Event    @relation(fields: [eventId], references: [id])
}

model CustomMetric {
  id             String         @id @default(uuid())
  organizationId String
  name           String
  description    String
  formula        String
  category       MetricCategory
  isActive       Boolean        @default(true)
  createdBy      String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  creator        User           @relation(fields: [createdBy], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

enum Role {
  ADMIN
  MEMBER
}

enum EventStatus {
  UPCOMING
  COMPLETED
  CANCELLED
}

enum Platform {
  RESIDENT_ADVISOR
  HUMANITIX
  MOSHTIX
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MetricCategory {
  REVENUE
  ATTENDANCE
  ENGAGEMENT
  CUSTOM
}
