# Database Configuration
# Get from Supabase, Neon, or your PostgreSQL provider
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Optional: Direct connection for migrations (if using connection pooling)
DATABASE_URL_UNPOOLED=postgresql://user:password@host:5432/database?sslmode=require

# Application
NODE_ENV=production

# Optional: Error tracking
# SENTRY_DSN=your_sentry_dsn_here

# Optional: Analytics (if using Vercel)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=your_analytics_id